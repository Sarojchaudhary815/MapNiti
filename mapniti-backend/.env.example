# ---------- Database ----------
# Local dev: leave DATABASE_URL unset to use SQLite (mapniti.db).
# Production (MySQL 8 / MariaDB 10.6+):
# DATABASE_URL=mysql+pymysql://mapniti_user:STRONG_PASSWORD@localhost:3306/mapniti?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=280

# ---------- Security ----------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ---------- Google Earth Engine ----------
GEE_PROJECT_ID=your-gee-cloud-project
# On a server use a service account (earthengine authenticate won't work headless):
GEE_SERVICE_ACCOUNT_EMAIL=mapniti@your-gee-cloud-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=/app/secrets/gee-key.json

# ---------- AI assistant (Claude) ----------
# Get a key at https://console.anthropic.com — leave empty to disable the assistant.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium
# …or Google Gemini (key from aistudio.google.com). AI_PROVIDER picks one: anthropic | gemini
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Public (logged-out) visitors of the website's /ai page get a smaller quota
AI_ANON_PER_HOUR=10
AI_ANON_PER_DAY=30
AI_USER_PER_HOUR=60
AI_USER_PER_DAY=300
# Set true only when behind your own reverse proxy (nginx/Caddy) so rate limits use the real client IP
TRUST_PROXY_HEADERS=false

# ---------- Email (OTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MapNiti
OTP_EXPIRE_MINUTES=10

# ---------- Google sign-in ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
